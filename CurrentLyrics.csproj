<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK version TFM: gives us the WinRT MediaPlayer, which can stream http(s)
         and FLAC. WPF's MediaPlayer refuses http sources, which forced a full download first. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms 的 NotifyIcon：WPF 自己没有托盘 API。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Darius Music</AssemblyName>
    <RootNamespace>CurrentLyrics</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>CurrentLyrics.Program</StartupObject>
    <Version>1.3.3</Version>
    <Product>Darius Music</Product>
    <AssemblyTitle>Darius Music</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 更新源跟着包走：发布时用 -p:UpdateFeedDefault=... 烘一个进去；留空则只认
         exe 旁边的 update-feed.txt（一行地址，# 开头是注释）。本仓库不内置任何地址。-->
    <UpdateFeedDefault Condition="'$(UpdateFeedDefault)' == ''"></UpdateFeedDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms 会加一条 global using System.Windows.Forms，和 WPF 的 Panel/DragEventArgs/
         KeyEventArgs 撞名；托盘代码里本来就用 System.Windows.Forms 全名，所以把这条隐式 using 去掉。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateFeed" Value="$(UpdateFeedDefault)" />
    <None Update="update-feed.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <ItemGroup>
    <Resource Include="Assets\app.png" />
    <None Update="Fonts\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Jint" Version="4.4.0" />
    <!-- D 方案（本地逐字对齐）：DirectML 后端。只含 win-x64/arm64 的原生库，所以发布必须带 -r win-x64
         （release.ps1 本来就是这么发的）。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <!-- 解码 mp3/flac 到 16 kHz 单声道采样：Media Foundation 的托管包装，底子还是系统解码器。 -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>

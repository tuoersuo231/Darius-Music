<Window x:Class="CurrentLyrics.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:CurrentLyrics.Controls"
        Title="Darius Music" Height="760" Width="1180" MinHeight="600" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.png"
        Background="{DynamicResource WindowWashBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="OnLoaded">
  <Grid x:Name="rootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.Children>
      <!-- 背景层：窗口背景色 → 主题壁纸。 -->
      <Grid x:Name="themeBackdrop" Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False">
        <Grid.Children>
          <Image x:Name="themeImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <!-- 背景暗度：铺一层黑，只压壁纸，不压频谱（频谱是后加进来的）。 -->
          <Border x:Name="themeScrim" Background="#000000" Opacity="0" IsHitTestVisible="False" />
        </Grid.Children>
      </Grid>
      <!-- No border at all: the sidebar's 1 DIP border brush is now transparent, and a Border paints its
           Background only *inside* its border, so that column was left unpainted — over a 0xDA panel it
           showed the raw cover as a 1 px bright seam down the whole window (user report: 没有覆盖的背景色线条). -->
      <Border x:Name="sidebarLayer" Grid.Column="0" Background="{DynamicResource SidebarBrush}">
        <Border.Child>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Children>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,8,8">
                <StackPanel>
                  <StackPanel.Children>
                    <TextBlock Text="音乐库" Style="{StaticResource SectionLabel}" />
                    <Button x:Name="btnLocal" Click="OnLocalClick" Style="{StaticResource GhostButton}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" HorizontalContentAlignment="Left" Padding="10,7,10,7">
                      <StackPanel Orientation="Horizontal">
                        <StackPanel.Children>
                          <TextBlock Text="本地音乐" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel.Children>
                      </StackPanel>
                      <Button.ContextMenu>
                        <ContextMenu>
                          <ContextMenu.Items>
                            <MenuItem Header="添加音频文件…" Click="OnAddFilesClick" />
                            <MenuItem Header="改用文件夹扫描…" Click="OnPickFolderClick" />
                            <Separator />
                            <MenuItem Header="清空曲库列表" Click="OnClearLibraryClick" />
                            <MenuItem Header="恢复被隐藏的曲目" Click="OnRestoreHiddenClick" />
                          </ContextMenu.Items>
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                    <Button x:Name="btnOnline" Click="OnOnlineClick" Style="{StaticResource GhostButton}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" HorizontalContentAlignment="Left" Padding="10,7,10,7" Margin="0,2,0,0">
                      <StackPanel Orientation="Horizontal">
                        <StackPanel.Children>
                          <TextBlock Text="在线搜索" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel.Children>
                      </StackPanel>
                      <Button.ContextMenu>
                        <ContextMenu ContextMenuOpening="OnOnlineMenuOpening">
                          <MenuItem Header="填入网易云 Cookie…" Click="OnNeteaseCookieClick" />
                          <MenuItem Header="音质">
                            <MenuItem Header="标准 128k" Tag="standard" Click="OnNeteaseQualityClick" />
                            <MenuItem Header="较高 192k" Tag="higher" Click="OnNeteaseQualityClick" />
                            <MenuItem Header="较高 320k" Tag="exhigh" Click="OnNeteaseQualityClick" />
                            <MenuItem Header="无损 FLAC（需会员）" Tag="lossless" Click="OnNeteaseQualityClick" />
                          </MenuItem>
                          <MenuItem x:Name="miLx" Header="落雪音源">
                            <MenuItem Header="导入脚本…" Click="OnLxImportClick" />
                            <Separator />
                            <MenuItem x:Name="miLxSmart" Header="自动切换（多个音源轮换）" IsCheckable="True" Click="OnLxSmartClick" />
                            <MenuItem x:Name="miLxRemove" Header="移除当前音源" Click="OnLxRemoveClick" />
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="清除 Cookie（匿名）" Click="OnNeteaseClearClick" />
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                    <Button x:Name="btnAddFiles" Click="OnAddFilesClick" Style="{StaticResource GhostButton}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" HorizontalContentAlignment="Left" Padding="10,7,10,7" Margin="0,2,0,0">
                      <StackPanel Orientation="Horizontal">
                        <StackPanel.Children>
                          <TextBlock Text="添加音频文件…" FontSize="12.5" VerticalAlignment="Center" />
                        </StackPanel.Children>
                      </StackPanel>
                    </Button>
                    <Grid Margin="6,18,0,4">
                      <Grid.Children>
                        <TextBlock Text="歌单" Style="{StaticResource SectionLabel}" Margin="0,0,0,0" VerticalAlignment="Center" />
                        <!-- Text-only: a filled ghost button on a 0xDA plate composites twice and reads as
                             an opaque chip (same as the search box). -->
                        <Button x:Name="btnNewPlaylist" Click="OnNewPlaylistClick" Style="{StaticResource GhostButton}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" HorizontalAlignment="Right" Padding="8,2,8,2" FontSize="11">+ 新建</Button>
                      </Grid.Children>
                    </Grid>
                    <ListBox x:Name="lstPlaylists" SelectionChanged="OnPlaylistSelected" PreviewMouseLeftButtonDown="OnPlaylistItemClick" Background="#00FFFFFF" BorderThickness="0,0,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="320">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                          <Setter Property="Padding" Value="0,0,0,0" />
                          <Setter Property="Margin" Value="0,1,0,1" />
                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="{x:Type ListBoxItem}">
<Border x:Name="bd" Background="#00FFFFFF" CornerRadius="9,9,9,9" Padding="8,5,8,5">
  <Border.Child>
    <ContentPresenter />
  </Border.Child>
</Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Value="{StaticResource RowHoverBrush}" Property="Background" />
                                  </Trigger>
                                  <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Value="{DynamicResource RowSelectedBrush}" Property="Background" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
<Grid>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>
  <Grid.Children>
    <Border Width="32" Height="32" CornerRadius="0,0,0,0" Background="{DynamicResource InsetBrush}" ClipToBounds="True">
      <Border.Child>
        <Grid>
          <Grid.Children>
            <TextBlock Text="♫" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Stretch="UniformToFill" Source="{Binding CoverImage}" />
          </Grid.Children>
        </Grid>
      </Border.Child>
    </Border>
    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
      <StackPanel.Children>
        <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
        <TextBlock FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="0,1,0,0" Text="{Binding CountText}" />
      </StackPanel.Children>
    </StackPanel>
  </Grid.Children>
</Grid>
</DataTemplate>
                      </ListBox.ItemTemplate>
                      <ListBox.ContextMenu>
                        <ContextMenu>
                          <ContextMenu.Items>
                            <MenuItem Header="添加歌曲…" Click="OnPlaylistAddSongs" />
                            <MenuItem Header="重命名" Click="OnPlaylistRename" />
                            <MenuItem Header="更换封面" Click="OnPlaylistChangeCover" />
                            <MenuItem Header="清理失效条目" Click="OnPlaylistCleanMissing" />
                            <Separator />
                            <MenuItem Header="删除歌单" Click="OnPlaylistDelete" />
                          </ContextMenu.Items>
                        </ContextMenu>
                      </ListBox.ContextMenu>
                    </ListBox>
                  </StackPanel.Children>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Margin="18,6,18,14">
                <StackPanel.Children>
                  <Button x:Name="btnOpenAppearance" Click="OnOpenAppearanceClick" Style="{StaticResource GhostButton}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" HorizontalContentAlignment="Left" Padding="8,6,8,6">
                    <StackPanel Orientation="Horizontal">
                      <StackPanel.Children>
                        <TextBlock Text="界面外观" FontSize="12" />
                      </StackPanel.Children>
                    </StackPanel>
                  </Button>
                  <Button x:Name="btnOpenSpectrum" Click="OnOpenSpectrumClick" Style="{StaticResource GhostButton}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" HorizontalContentAlignment="Left" Padding="8,6,8,6">
                    <StackPanel Orientation="Horizontal">
                      <StackPanel.Children>
                        <TextBlock Text="频谱设置" FontSize="12" />
                      </StackPanel.Children>
                    </StackPanel>
                  </Button>
                  <Button x:Name="btnOpenSettings" Click="OnOpenSettingsClick" Style="{StaticResource GhostButton}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" HorizontalContentAlignment="Left" Padding="8,6,8,6">
                    <StackPanel Orientation="Horizontal">
                      <StackPanel.Children>
                        <TextBlock Text="桌面歌词设置" FontSize="12" />
                      </StackPanel.Children>
                    </StackPanel>
                  </Button>
                  <Button x:Name="btnOpenDownload" Click="OnOpenDownloadClick" Style="{StaticResource GhostButton}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" HorizontalContentAlignment="Left" Padding="8,6,8,6">
                    <StackPanel Orientation="Horizontal">
                      <StackPanel.Children>
                        <TextBlock Text="下载与存储" FontSize="12" />
                      </StackPanel.Children>
                    </StackPanel>
                  </Button>
                  <Button x:Name="btnOpenHotkeys" Click="OnOpenHotkeysClick" Style="{StaticResource GhostButton}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" HorizontalContentAlignment="Left" Padding="8,6,8,6">
                    <StackPanel Orientation="Horizontal">
                      <StackPanel.Children>
                        <TextBlock Text="快捷键" FontSize="12" />
                      </StackPanel.Children>
                    </StackPanel>
                  </Button>
                  <Button x:Name="btnCheckUpdate" Click="OnCheckUpdateClick" Style="{StaticResource GhostButton}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" HorizontalContentAlignment="Stretch" Padding="8,6,8,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="检查更新" FontSize="12" />
                      <TextBlock x:Name="txtUpdateHint" Grid.Column="1" Text="" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,2,0" Foreground="{DynamicResource TextFaintBrush}" />
                    </Grid>
                  </Button>
                </StackPanel.Children>
              </StackPanel>
            </Grid.Children>
          </Grid>
        </Border.Child>
      </Border>
      <Grid x:Name="libraryLayer" Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Children>
          <Grid Grid.Row="0" Height="128" ClipToBounds="True">
            <Grid.Children>
              <!-- A flat card plate, the same colour the list and the player bar sit on. It used to be
                   HeaderScrimBrush — a window-coloured gradient that turned dark towards the bottom,
                   which read as two dirty bands across the cover header whenever the artwork was
                   brighter than the palette (user report: 封面显示栏上下有深色渐变). -->
              <Border Background="{DynamicResource CardBrush}" />
              <Grid Margin="26,22,26,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.Children>
                  <Border Width="92" Height="92" CornerRadius="0,0,0,0" Background="{DynamicResource InsetBrush}" ClipToBounds="True">
                    <Border.Effect>
                      <DropShadowEffect Color="#FF000000" BlurRadius="22" ShadowDepth="4" Opacity="0.55" />
                    </Border.Effect>
                    <Border.Child>
                      <Grid>
                        <Grid.Children>
                          <TextBlock x:Name="txtHeaderGlyph" Text="♫" FontSize="30" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Image x:Name="imgHeader" Stretch="UniformToFill" />
                        </Grid.Children>
                      </Grid>
                    </Border.Child>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="18,2,0,0" VerticalAlignment="Center">
                    <StackPanel.Children>
                      <TextBlock x:Name="txtViewName" Text="音乐库" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="txtViewSub" Text="选择本地音乐文件夹开始播放" FontSize="12" Foreground="{DynamicResource TextDimBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel.Children>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <StackPanel.Children>
                      <Grid Width="190" Margin="0,0,10,0">
                        <Grid.Children>
                          <!-- No fill at rest: with a photo backdrop every panel is a 0xDA plate, so a filled box
                               on top of it composited twice and read as an opaque chip painted in the 背景色
                               itself (user report: 这些UI没有透色). While the box is in use it still lifts to
                               the inset step and gets the accent border from the TextBox style, so the field
                               is not a blind click target. -->
                          <TextBox x:Name="txtSearch" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" Padding="28,7,10,7">
                            <TextBox.Style>
                              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Background" Value="#00FFFFFF" />
                                <Style.Triggers>
                                  <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
                                  </Trigger>
                                </Style.Triggers>
                              </Style>
                            </TextBox.Style>
                          </TextBox>
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid.Children>
                      </Grid>
                      <Button x:Name="btnPlayAll" Click="OnPlayAllClick" Style="{StaticResource PlayButton}" Width="38" Height="38" ToolTipService.ToolTip="播放全部">
                        <Path Data="M2,0L14,8 2,16z" Fill="#FF0A0C10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>
                    </StackPanel.Children>
                  </StackPanel>
                </Grid.Children>
              </Grid>
            </Grid.Children>
          </Grid>
          <Border Grid.Row="1" Margin="0" CornerRadius="0" Background="{DynamicResource CardGradientBrush}">
            <Border.Child>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Children>
                  <!-- Same 1 px trap as the sidebar: a transparent bottom border leaves an unpainted row
                       above the song list, which read as a horizontal background-coloured line. -->
                  <Border Margin="12,8,12,0" Padding="0,0,0,7">
                    <Border.Child>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="42" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="250" />
                          <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <Grid.Children>
                          <TextBlock Text="#" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="标题" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="专辑" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="时长" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid.Children>
                      </Grid>
                    </Border.Child>
                  </Border>
                  <Grid Grid.Row="1">
                    <Grid.Children>
                      <ListBox x:Name="lstSongs" MouseLeftButtonUp="OnSongClick" ContextMenuOpening="OnSongContextMenuOpening" PreviewMouseLeftButtonDown="OnSongDragStart" PreviewMouseMove="OnSongDragMove" Drop="OnSongDrop" DragOver="OnSongDragOver" Style="{StaticResource SongList}" Margin="0,4,0,8" AllowDrop="True">
                        <ListBox.ContextMenu>
                          <ContextMenu>
                            <ContextMenu.Items>
                              <MenuItem x:Name="miPlay" Header="播放" Click="OnSongMenuPlay" />
                              <MenuItem x:Name="miAddPlaylist" Header="添加到歌单…" Click="OnSongMenuAddToPlaylist" />
                              <MenuItem x:Name="miDownload" Header="下载到本地" Click="OnSongMenuDownload" />
                              <MenuItem x:Name="miSaveAs" Header="另存到…" Click="OnSongMenuSaveAs" />
                              <MenuItem Header="从当前列表移除" Click="OnSongMenuRemove" />
                              <Separator />
                              <MenuItem Header="在文件夹中显示" Click="OnSongMenuReveal" />
                              <MenuItem Header="复制歌曲信息" Click="OnSongMenuCopy" />
                            </ContextMenu.Items>
                          </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
<Grid>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="42" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="250" />
    <ColumnDefinition Width="64" />
  </Grid.ColumnDefinitions>
  <Grid.Children>
    <Grid Grid.Column="0">
      <Grid.Children>
        <TextBlock FontSize="11" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Index}">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid.Children>
    </Grid>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
      <StackPanel.Children>
        <Border Width="36" Height="36" CornerRadius="0,0,0,0" Background="{DynamicResource InsetBrush}" ClipToBounds="True">
          <Border.Child>
            <Grid>
              <Grid.Children>
                <TextBlock Text="♪" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Stretch="UniformToFill" Source="{Binding Cover}" />
              </Grid.Children>
            </Grid>
          </Border.Child>
        </Border>
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
          <StackPanel.Children>
            <TextBlock FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding DisplayTitle}">
              <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Text="{Binding DisplayArtist}" />
          </StackPanel.Children>
        </StackPanel>
      </StackPanel.Children>
    </StackPanel>
    <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Album}" />
    <Grid Grid.Column="3">
      <Grid.Children>
        <TextBlock FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding DurationText}">
          <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Button Click="OnRowRemoveClick" Style="{StaticResource RowDeleteButton}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="从当前列表移除（不删除文件）"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
      </Grid.Children>
    </Grid>
  </Grid.Children>
</Grid>
</DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <Canvas x:Name="dragLayer" Margin="6,0,6,8" IsHitTestVisible="False" ClipToBounds="True" />
                      <Border x:Name="undoBar" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16" Background="#F51A1E27" BorderBrush="#FF333B4C" BorderThickness="1,1,1,1" CornerRadius="12,12,12,12" Padding="14,8,14,8" Visibility="Collapsed" Opacity="0">
                        <Border.Child>
                          <StackPanel Orientation="Horizontal">
                            <StackPanel.Children>
                              <TextBlock x:Name="txtUndo" FontSize="12" VerticalAlignment="Center" />
                              <Button x:Name="btnUndo" Click="OnUndoClick" Style="{StaticResource GhostButton}" Padding="10,3,10,3" FontSize="12" Margin="14,0,0,0">撤销</Button>
                            </StackPanel.Children>
                          </StackPanel>
                        </Border.Child>
                      </Border>
                    </Grid.Children>
                  </Grid>
                  <StackPanel x:Name="emptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Children>
                      <TextBlock Text="♫" FontSize="40" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" />
                      <TextBlock x:Name="txtEmptyTitle" Text="这里是空的" FontSize="14" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                      <TextBlock x:Name="txtEmptyHint" Text="点左侧「本地音乐」选择你的音乐目录" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel.Children>
                  </StackPanel>
                  <Grid Grid.Row="2" Margin="20,0,20,10">
                    <Grid.Children>
                      <TextBlock x:Name="txtListFooter" Text="" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                    </Grid.Children>
                  </Grid>
                </Grid.Children>
              </Grid>
            </Border.Child>
          </Border>
          <!-- No gap above the player bar: the 12 DIP strip used to show the raw (bright) cover
               backdrop through it, which read as a missing block under the song list. -->
          <Border Grid.Row="2" Height="92" Margin="0" Background="{DynamicResource CardBrush}">
            <Border.Child>
              <Grid>
                <Grid.Children>
                  <Grid x:Name="playerBar" MouseLeftButtonUp="OnPlayerBarClick" Margin="24,0,24,0" Background="#00FFFFFF">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Children>
                      <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" MinWidth="150" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.Children>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Children>
                              <Border Width="54" Height="54" CornerRadius="0,0,0,0" Background="#00FFFFFF" ClipToBounds="True">
                                <Border.Effect>
                                  <DropShadowEffect Color="#FF000000" BlurRadius="16" ShadowDepth="3" Opacity="0.5" />
                                </Border.Effect>
                                <Border.Child>
                                  <Grid>
                                    <Grid.Children>
                                      <TextBlock Text="♪" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      <Image x:Name="imgCover" Stretch="UniformToFill" />
                                    </Grid.Children>
                                  </Grid>
                                </Border.Child>
                              </Border>
                              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="220">
                                <StackPanel.Children>
                                  <TextBlock x:Name="txtTitle" Text="未在播放" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock x:Name="txtArtist" Text="本地音乐" FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel.Children>
                              </StackPanel>
                            </StackPanel.Children>
                          </StackPanel>
                          <StackPanel x:Name="centerBlock" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Children>
                              <Button x:Name="btnPrev" Click="OnPrevClick" Style="{StaticResource IconButton}" ToolTipService.ToolTip="上一首">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                              </Button>
                              <Button x:Name="btnPlay" Click="OnPlayClick" Style="{StaticResource PlayButton}" Margin="8,0,8,0" ToolTipService.ToolTip="播放 / 暂停">
                                <Grid Width="14" Height="14">
                                  <Grid.Children>
                                    <Path x:Name="pathPlayIcon" Data="M1,0L13,7 1,14z" Fill="#FF0A0C10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" />
                                    <Path x:Name="pathPauseIcon" Data="M1,0L5,0 5,14 1,14z M9,0L13,0 13,14 9,14z" Fill="#FF0A0C10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                  </Grid.Children>
                                </Grid>
                              </Button>
                              <Button x:Name="btnNext" Click="OnNextClick" Style="{StaticResource IconButton}" ToolTipService.ToolTip="下一首">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                              </Button>
                            </StackPanel.Children>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Children>
                              <!-- Text-only, like + 新建: the pill used to be the same colour as the bar. -->
                              <Button x:Name="btnPlayMode" Click="OnPlayModeClick" Style="{StaticResource GhostButton}" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" Height="28" Padding="10,0,10,0" Margin="0,0,16,0" ToolTipService.ToolTip="单击切换：顺序播放 / 单曲循环">
                                <StackPanel Orientation="Horizontal">
                                  <StackPanel.Children>
                                    <TextBlock x:Name="txtPlayModeIcon" Text="⇉" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource TextDimBrush}" />
                                    <TextBlock x:Name="txtPlayMode" Text="顺序播放" FontSize="12" />
                                  </StackPanel.Children>
                                </StackPanel>
                              </Button>
                              <CheckBox x:Name="chkLyrics" Checked="OnLyricsToggle" Unchecked="OnLyricsToggle" Style="{StaticResource Switch}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center">桌面歌词</CheckBox>
                              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="16,0,8,0" FontSize="12" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                              <Slider x:Name="sldVolume" ValueChanged="OnVolumeChanged" Width="80" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" Value="0.85" VerticalAlignment="Center" />
                            </StackPanel.Children>
                          </StackPanel>
                        </Grid.Children>
                      </Grid>
                      <Grid x:Name="seekRow" Grid.Row="1" Margin="0,0,0,11">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="42" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <Grid.Children>
                          <TextBlock x:Name="txtPos" Text="0:00" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                          <Slider x:Name="sldProgress" ValueChanged="OnProgressChanged" Grid.Column="1" Style="{StaticResource ThinSlider}" IsMoveToPointEnabled="True" />
                          <TextBlock x:Name="txtDur" Grid.Column="2" Text="0:00" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid.Children>
                      </Grid>
                    </Grid.Children>
                  </Grid>
                </Grid.Children>
              </Grid>
            </Border.Child>
          </Border>
        </Grid.Children>
      </Grid>
      <!-- 窗口最底部的装饰频谱：不参与布局（所以调高度不会顶动任何面板），
           盖在面板之上、播放页之下，且完全不吃鼠标事件。 -->
      <ctl:SpectrumView x:Name="bottomSpectrum" Grid.ColumnSpan="2" Panel.ZIndex="11"
                        VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
      <Grid x:Name="playerPage" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="10" />
    </Grid.Children>
  </Grid>
</Window>
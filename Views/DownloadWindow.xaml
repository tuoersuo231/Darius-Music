<Window x:Class="CurrentLyrics.Views.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载与存储" Width="480" Height="700" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowWashBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        Icon="/Assets/app.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="26,22,26,12">
            <TextBlock Text="下载与存储" Style="{StaticResource H1}" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,14,14,16">
            <StackPanel Margin="0,0,6,10">

                <TextBlock Text="下载位置" Style="{StaticResource SectionLabel}" />
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18,14"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="txtFolder" Text="" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="txtFolderState" Text="" Style="{StaticResource Caption}"
                                   Margin="0,5,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="btnPickFolder" Content="更改目录…" Style="{StaticResource GhostButton}"
                                    Padding="14,4" Height="30" FontSize="12" Click="OnPickFolder" />
                            <Button x:Name="btnOpenFolder" Content="打开目录" Style="{StaticResource GhostButton}"
                                    Padding="14,4" Height="30" FontSize="12" Margin="8,0,0,0" Click="OnOpenFolder" />
                            <Button x:Name="btnResetFolder" Content="恢复默认" Style="{StaticResource GhostButton}"
                                    Padding="14,4" Height="30" FontSize="12" Margin="8,0,0,0" Click="OnResetFolder" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="下载音质" Style="{StaticResource SectionLabel}" />
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18,14"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="优先音质" FontSize="13" VerticalAlignment="Center" />
                            <ComboBox x:Name="cmbQuality" Width="150" HorizontalAlignment="Right"
                                      SelectionChanged="OnQualityChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="下载之后" Style="{StaticResource SectionLabel}" />
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18,14"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="自动加入本地音乐" FontSize="13" VerticalAlignment="Center" />
                            <CheckBox x:Name="chkAddLibrary" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="OnAddLibraryChanged" Unchecked="OnAddLibraryChanged" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,14" />
                        <TextBlock Text="当前目录内容" FontSize="13" />
                        <TextBlock x:Name="txtUsage" Text="" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Button Content="完成" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        Width="96" Click="OnDone" />
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="CurrentLyrics.Views.PlaylistPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加到歌单" Width="460" Height="540" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowWashBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        Icon="/Assets/app.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="26,22,26,14">
            <StackPanel>
                <TextBlock Text="添加到歌单" Style="{StaticResource H1}" />
                <TextBlock x:Name="txtSong" Text="" Style="{StaticResource Caption}" Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,12,14,12">
            <StackPanel x:Name="rowHost" Margin="0,0,6,6" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Button Content="取消" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                        Width="88" Click="OnCancel" />
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="CurrentLyrics.Views.HotkeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键" Width="460" Height="600" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowWashBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        Icon="/Assets/app.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="26,22,26,16">
            <TextBlock Text="快捷键" Style="{StaticResource H1}" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,14,14,10">
            <StackPanel Margin="0,0,6,10">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18,6"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <StackPanel x:Name="hotkeyRows" />
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="18,14"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="游戏里也能用" FontSize="13" />
                            <TextBlock x:Name="txtAdmin" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="chkAdmin" Grid.Column="1" Style="{StaticResource Switch}"
                                  VerticalAlignment="Center" Click="OnAdminToggle" />
                    </Grid>
                </Border>
                <TextBlock x:Name="txtStatus" TextWrapping="Wrap" FontSize="12" Margin="4,10,0,0"
                           Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="20,12,20,16">
            <Grid>
                <Button x:Name="btnResetAll" Content="恢复默认" Style="{StaticResource GhostButton}"
                        Padding="12,5" FontSize="12" HorizontalAlignment="Left" Click="OnResetAll" />
                <Button x:Name="btnClose" Content="完成" Style="{StaticResource GhostButton}"
                        Padding="16,5" FontSize="12" HorizontalAlignment="Right" Click="OnClose" />
            </Grid>
        </Border>
    </Grid>
</Window>
